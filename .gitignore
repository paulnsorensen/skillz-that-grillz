# Python
__pycache__/
*.pyc
.venv/
# Hypothesis example database: local runs only. With CI set, Hypothesis loads its built-in `ci` profile, which has no database.
.hypothesis/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Workflow scratch (age/cure/press reports, planning notes)
.cheese/
.context/

# Skill archives: build output. `just build` writes them; CI publishes them on dist (ADR-012).
skills/*/scripts/*.pyz

# Skill-creator iteration workspaces (eval runs, benchmarks, viewer HTML)
skills/*-workspace/

# Live smoke run records (just live-smoke)
.live-smoke/

# Serena MCP — machine-local; not tracked
.serena/
