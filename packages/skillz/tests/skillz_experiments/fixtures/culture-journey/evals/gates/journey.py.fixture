import json, pathlib
SOURCE = {'.py', '.js', '.ts', '.go', '.rs', '.java'}
bad = [str(p) for p in pathlib.Path('output').rglob('*') if p.suffix in SOURCE]
for line in pathlib.Path('trace/events.jsonl').read_text().splitlines():
    event = json.loads(line)
    content = (event.get('message') or {}).get('content')
    for block in content if isinstance(content, list) else []:
        if event.get('type') == 'assistant' and block.get('type') == 'tool_use' and block.get('name') in ('Write', 'Edit'):
            path = str(block.get('input', {}).get('file_path', ''))
            if pathlib.Path(path).suffix in SOURCE:
                bad.append(path)
print(json.dumps({'score': 0 if bad else 1}))