#!/usr/bin/env bash
# Queue-read script for burn-down-todos ralphs.
#
# Drop this file into the ralph directory as `next-issue.sh`,
# `chmod +x` it, and reference it from RALPH.md's `commands.next-issue`.
#
# Contract — stdout begins with one of:
#   Path: <file>            queue still has open items; per-item iteration
#   QUEUE EMPTY             queue is drained; closer iteration
#   QUEUE READ ERROR        queue dir missing (wrong branch); recovery iteration
#
# CRITICAL: a missing queue directory MUST print `QUEUE READ ERROR`, NOT
# `QUEUE EMPTY`. Treating "directory absent" as "queue drained" is the
# silent-queue-empty footgun documented under Common bugs in
# `references/guards.md` — it lets the closer fire on a phantom-empty queue
# when the working tree is on a per-item branch where the queue dir is
# gitignored and absent.
#
# Placeholders to fill in before use:
#   PLACEHOLDER_QUEUE_DIR     queue directory relative to repo root,
#                             e.g. ".cheese/issues" or "tasks"
#   PLACEHOLDER_QUEUE_GLOB    glob that matches one queue item file,
#                             e.g. "oslo-v1-*.md"
#   PLACEHOLDER_STATUS_FIELD  YAML frontmatter field on each queue item
#                             that gates open/done, e.g. "status"
#   PLACEHOLDER_PLANNING_BRANCH  branch where the queue files live
#                                (printed in the QUEUE READ ERROR hint),
#                                e.g. "paulnsorensen/mold-myralph"
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
issues_dir="$repo_root/PLACEHOLDER_QUEUE_DIR"
branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)"

if [ ! -d "$issues_dir" ]; then
  cat <<EOF
QUEUE READ ERROR

The queue directory ($issues_dir) does not exist on branch '$branch'.

The queue lives only on the planning branch (PLACEHOLDER_PLANNING_BRANCH).
Switch to that branch before reading or flipping queue state.

Do NOT interpret this output as 'QUEUE EMPTY'. Do NOT run the closer.
The correct response is to checkout the planning branch and let the next
firing render a real queue read.
EOF
  exit 0
fi

# shellcheck disable=SC2043  # PLACEHOLDER_QUEUE_GLOB is a literal token in
# the template; once substituted with a real glob (e.g. "oslo-v1-*.md"), the
# loop expands to multiple files. shellcheck cannot see past the placeholder.
for f in "$issues_dir"/PLACEHOLDER_QUEUE_GLOB; do
  [ -f "$f" ] || continue
  status=$(awk '/^---$/{c++; next} c==1 && /^PLACEHOLDER_STATUS_FIELD:[[:space:]]/{
    sub(/^PLACEHOLDER_STATUS_FIELD:[[:space:]]*/, ""); print; exit
  }' "$f")
  if [ "$status" = "open" ]; then
    echo "Path: $f"
    echo
    cat "$f"
    exit 0
  fi
done

echo "QUEUE EMPTY"
echo
echo "All queue items are PLACEHOLDER_STATUS_FIELD: done."
echo "Closer iteration: run ./closer-gate.sh first, require CLOSER GATE PASS,"
echo "then run the project-specific closer steps and emit"
echo "<promise>COMPLETE</promise> on its own line."
