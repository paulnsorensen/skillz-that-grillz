{
  "schema_version": 1,
  "status": "approved",
  "skill": "skillz",
  "invocation": "$skillz audit",
  "kinds": {
    "task": {
      "grader": "judge",
      "rubric": "Score the audit report of fixture.md against the expected findings. Give 100 when the report names every expected finding at its location with a correct fix and adds no false finding. Subtract an equal share for each missed finding, wrong location, wrong fix, or false finding. Give 0 when the report is missing or audits a different file."
    },
    "inspection": {
      "grader": "exact-json"
    },
    "audit": {
      "grader": "audit"
    }
  },
  "helper": {
    "path": "scripts/inspect_skill.py",
    "input": "fixture.md",
    "fixtures": [
      {
        "input": "---\nname: contract\ndescription: Inspect\n---\n# Body\n[Guide](references/guide.md)\n",
        "returncode": 0,
        "output": {
          "schema_version": 3,
          "advisory_sentences": [],
          "frontmatter_keys": [
            "description",
            "name"
          ],
          "body_line_count": 2,
          "local_link_targets": [
            "references/guide.md"
          ],
          "long_sentences": []
        }
      },
      {
        "input": "---\nname: contract\n---\n[Escape](../secret)\n",
        "returncode": 2,
        "output": {
          "schema_version": 3,
          "error": "link escapes package"
        }
      }
    ]
  },
  "editable": []
}
