{
  "schema_version": 1,
  "status": "approved",
  "skill": "skillz",
  "invocation": "$skillz audit",
  "kinds": {
    "task": {
      "grader": "judge",
      "rubric": "Score the audit report of fixture.md against the findings in `reference`. When `reference` lists no findings, give 100 only to a report with no findings. Otherwise give 100 when the report names each reference finding, its location, and a correct fix, with no false finding. Subtract 100 divided by the number of reference findings for each missed finding, wrong location, wrong fix, or false finding. Do not go below 0. Give 0 when the report is missing or audits a different file."
    },
    "inspection": {
      "grader": "exact-json"
    },
    "audit": {
      "grader": "audit"
    }
  },
  "helper": {
    "path": "scripts/inspect-skill.pyz",
    "input": "fixture.md",
    "fixtures": [
      {
        "input": "---\nname: contract\ndescription: Inspect\n---\n# Body\n[Guide](references/guide.md)\n",
        "returncode": 0,
        "output": {
          "schema_version": 4,
          "advisory_sentences": [],
          "frontmatter_keys": [
            "description",
            "name"
          ],
          "body_line_count": 2,
          "local_link_targets": [
            "references/guide.md"
          ],
          "long_sentences": []
        }
      },
      {
        "input": "---\nname: contract\n---\n[Escape](../secret)\n",
        "returncode": 3,
        "output": null,
        "error": {
          "error": "inspect: link escapes package",
          "exit_code": 3
        }
      }
    ]
  },
  "editable": [
    "SKILL.md",
    "references/anti-patterns.md",
    "references/description-optimization.md",
    "references/offload.md",
    "references/progressive-disclosure.md"
  ]
}
