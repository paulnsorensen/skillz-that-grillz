{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RUN/cases.draft.json",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "family",
      "id",
      "kind",
      "request",
      "source"
    ],
    "properties": {
      "brief": {
        "type": "string",
        "pattern": "\\S",
        "description": "What the simulated user wants and knows."
      },
      "expected": {
        "description": "The reference. A journey case takes the typed object. A judged task case takes an object with criteria, next to its expected_output and assertions."
      },
      "family": {
        "type": "string",
        "pattern": "\\S",
        "description": "Group of related cases. Defaults to the id."
      },
      "files": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        },
        "description": "Inline files: path to text."
      },
      "id": {
        "type": "string",
        "pattern": "\\S",
        "description": "Unique case id."
      },
      "kind": {
        "type": "string",
        "pattern": "\\S",
        "description": "trigger, near-miss, task, or a journey kind of the contract."
      },
      "max_turns": {
        "type": "integer",
        "minimum": 1,
        "default": 8
      },
      "request": {
        "type": "string",
        "pattern": "\\S",
        "description": "The first user message."
      },
      "requirements": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "\\S"
        },
        "uniqueItems": true
      },
      "source": {
        "enum": [
          "skill",
          "session"
        ]
      }
    },
    "additionalProperties": false
  }
}
