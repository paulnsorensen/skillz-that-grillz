{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RUN/cases.draft.json",
  "$defs": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "family",
          "id",
          "kind",
          "request",
          "source"
        ],
        "properties": {
          "brief": {
            "type": "string",
            "pattern": "\\S",
            "description": "What the simulated user wants and knows."
          },
          "expected": {
            "description": "The reference. A journey case takes the typed object. A judged task case takes an object with criteria, next to its expected_output and assertions.",
            "properties": {
              "criteria": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "text"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_.-]{1,64}$"
                    },
                    "text": {
                      "type": "string",
                      "pattern": "\\S",
                      "maxLength": 1000,
                      "description": "One EARS statement: at most one leading WHEN, WHILE, IF, or WHERE clause, then one THE <subject> SHALL <response>."
                    },
                    "must": {
                      "type": "boolean",
                      "default": false,
                      "description": "A dealbreaker: level 1 or 2 scores the case 0."
                    },
                    "from": {
                      "type": "string",
                      "pattern": "\\S",
                      "maxLength": 1000,
                      "description": "The source item, such as assertion:2, must:0, questions, or final_stop."
                    }
                  }
                },
                "description": "the approved EARS statements that the judge grades, one level per criterion id"
              }
            }
          },
          "family": {
            "type": "string",
            "pattern": "\\S",
            "description": "Group of related cases. Defaults to the id."
          },
          "files": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": {
                  "anyOf": [
                    {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "required": [
                            "base64",
                            "type"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "base64": {
                              "type": "string"
                            },
                            "type": {
                              "enum": [
                                "png",
                                "jpg",
                                "webp",
                                "gif"
                              ]
                            }
                          }
                        }
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "description": "Path list, or path map with inline text, image markers, and null references into top-level fixtures."
          },
          "id": {
            "type": "string",
            "pattern": "\\S",
            "description": "Unique case id."
          },
          "kind": {
            "type": "string",
            "pattern": "\\S",
            "description": "trigger, near-miss, task, or a journey kind of the contract."
          },
          "max_turns": {
            "type": "integer",
            "minimum": 1,
            "default": 8
          },
          "proof": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "pass": {
                "type": "string",
                "pattern": "^evals/(?!\\.|[\\s\\S]*/\\.)(?![\\s\\S]*\\\\)(?![\\s\\S]*\\x00)[^/]+(?:/[^/]+)*$"
              },
              "fail": {
                "type": "string",
                "pattern": "^evals/(?!\\.|[\\s\\S]*/\\.)(?![\\s\\S]*\\\\)(?![\\s\\S]*\\x00)[^/]+(?:/[^/]+)*$"
              }
            }
          },
          "regression": {
            "type": "boolean",
            "description": "A case drafted from a field failure. Needs source: session. The headroom pass records whether the seed fails it."
          },
          "request": {
            "type": "string",
            "pattern": "\\S",
            "description": "The first user message."
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "source": {
            "enum": [
              "skill",
              "session"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/cases",
      "items": {
        "properties": {
          "files": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "required": [
                        "base64",
                        "type"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "base64": {
                          "type": "string"
                        },
                        "type": {
                          "enum": [
                            "png",
                            "jpg",
                            "webp",
                            "gif"
                          ]
                        }
                      }
                    }
                  ]
                }
              },
              {
                "const": []
              }
            ]
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "cases"
      ],
      "additionalProperties": false,
      "properties": {
        "fixtures": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "base64",
                  "type"
                ],
                "additionalProperties": false,
                "properties": {
                  "base64": {
                    "type": "string"
                  },
                  "type": {
                    "enum": [
                      "png",
                      "jpg",
                      "webp",
                      "gif"
                    ]
                  }
                }
              }
            ]
          },
          "description": "Shared files: path to text or an image marker, stored once."
        },
        "cases": {
          "$ref": "#/$defs/cases"
        }
      }
    }
  ]
}
