{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "evals/autoimprove.json",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "skill",
    "invocation",
    "kinds"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Editor hint. The runner ignores it."
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "approved",
        "draft"
      ],
      "description": "A draft contract stops a run until the user approves it."
    },
    "skill": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "invocation": {
      "type": "string",
      "pattern": "\\S"
    },
    "kinds": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "grader"
        ],
        "properties": {
          "grader": {
            "enum": [
              "exact-json",
              "judge",
              "command",
              "hybrid",
              "audit",
              "journey"
            ]
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "gate": {
            "type": "string",
            "pattern": "\\S",
            "description": "A gate file under evals/gates/, as a relative path. It stands for argv."
          },
          "rubric": {
            "type": "string",
            "pattern": "\\S"
          },
          "capture": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "pillars": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,31}$"
            }
          }
        },
        "additionalProperties": false,
        "not": {
          "required": [
            "argv",
            "gate"
          ]
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "grader": {
                  "enum": [
                    "command",
                    "hybrid",
                    "journey"
                  ]
                }
              },
              "required": [
                "grader"
              ]
            },
            "then": {
              "anyOf": [
                {
                  "required": [
                    "argv"
                  ]
                },
                {
                  "required": [
                    "gate"
                  ]
                }
              ]
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "argv"
                    ]
                  },
                  {
                    "required": [
                      "gate"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "grader": {
                  "enum": [
                    "judge",
                    "hybrid",
                    "journey"
                  ]
                }
              },
              "required": [
                "grader"
              ]
            },
            "then": {
              "required": [
                "rubric"
              ]
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "rubric"
                    ]
                  },
                  {
                    "required": [
                      "capture"
                    ]
                  },
                  {
                    "required": [
                      "pillars"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    },
    "helper": {
      "type": "object",
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/.\\\\][^\\\\]*$"
        },
        "input": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/.\\\\][^\\\\]*$"
        },
        "fixtures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "input",
              "returncode",
              "output"
            ],
            "properties": {
              "input": {
                "type": "string",
                "pattern": "\\S"
              },
              "returncode": {
                "type": "integer"
              },
              "output": {},
              "error": {
                "type": "object"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "editable": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^/.\\\\][^\\\\]*$"
      }
    },
    "surface": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "tools": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,127}$"
          }
        },
        "mcp_config": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/.\\\\][^\\\\]*\\.json$"
        },
        "agents": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^/.\\\\][^\\\\]*\\.md$"
          }
        },
        "companions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^/.\\\\][^\\\\]*$"
          }
        }
      }
    },
    "statistics": {
      "type": "object",
      "properties": {
        "min_gain": {
          "type": "number",
          "minimum": 0
        },
        "min_lower_bound": {
          "type": "number",
          "minimum": 0
        },
        "family_budget": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "family_budgets": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "max_token_increase_per_gain": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "min_token_saving": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1,
          "description": "Accepts null or a number above 0 and below 1."
        },
        "min_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Accepts a number from 0 to 1."
        },
        "max_quality_loss": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
